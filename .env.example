# Copy to .env and fill in. Never commit .env.

# Supabase Postgres via the Transaction pooler (Supabase -> Connect -> Transaction).
# Username is postgres.<project-ref>, port 6543, no [ ] around the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Tried in order; run `python scripts/check_gemini.py` to see which work for your key.
GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-2.5-flash-lite

# Optional: store diagnosis photos (Supabase -> Settings -> API -> service_role key)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=diagnoses
