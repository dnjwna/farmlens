# Copy to .env and fill in. Never commit .env.

# Supabase Postgres via the Transaction pooler (Supabase -> Connect -> Transaction).
# Username is postgres.<project-ref>, port 6543, no [ ] around the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: separate key (from another Google Cloud project) for scripts/evaluate_diagnosis.py,
# so evaluation does not use up the free-tier quota the app needs.
EVAL_GEMINI_API_KEY=
# Tried in order; run `python scripts/check_gemini.py` to see which work for your key.
GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-2.5-flash-lite

# Optional: store diagnosis photos (Supabase -> Settings -> API -> service_role key)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=diagnoses

# Daily parametric-insurance check (06:00 WIB by default)
INSURANCE_SCHEDULER_ENABLED=true
INSURANCE_CHECK_HOUR=6
# python -c "import secrets; print(secrets.token_urlsafe(32))"  -- empty disables /api/v1/admin/*
ADMIN_API_KEY=

# Forgot-password codes: "console" (dev, printed in server log) or "openwa"
OTP_PROVIDER=console
# OpenWA (https://github.com/rmyndharis/OpenWA). Unofficial WhatsApp client: use a dedicated number.
OPENWA_BASE_URL=http://localhost:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_ID=
